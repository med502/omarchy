#!/bin/bash

# omarchy:summary=Install QEMU and Virtual Machine Manager.
# omarchy:requires-sudo=true

echo "Installing QEMU and Virtual Machine Manager..."
omarchy-pkg-add dnsmasq qemu-desktop virt-manager

# virt-manager uses `#!/usr/bin/env python3`, which resolves to mise's Python
# and cannot import Arch's system PyGObject bindings. Pin it to system Python.
sudo sed -i '/env python3/ c\#!/bin/python3' /usr/bin/virt-manager

echo "Starting the libvirt QEMU, storage, and network daemons..."
sudo systemctl enable --now virtqemud.socket virtstoraged.socket virtnetworkd.socket

# libvirt ships a default NAT network but does not enable it by default.
sudo virsh net-autostart default
if ! sudo virsh net-info default | rg -q '^Active:.*yes$'; then
  sudo virsh net-start default
fi

# UFW's default-deny input policy otherwise drops DHCP and DNS from guests.
sudo ufw allow in on virbr0 to any port 53 proto tcp comment 'omarchy-libvirt-dns' >/dev/null
sudo ufw allow in on virbr0 to any port 53 proto udp comment 'omarchy-libvirt-dns' >/dev/null
sudo ufw allow in on virbr0 to any port 67 proto udp comment 'omarchy-libvirt-dhcp' >/dev/null
sudo ufw route allow in on virbr0 comment 'omarchy-libvirt-forward' >/dev/null
sudo ufw reload >/dev/null
