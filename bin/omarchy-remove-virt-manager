#!/bin/bash

# omarchy:summary=Remove QEMU and Virtual Machine Manager.
# omarchy:requires-sudo=true

sudo ufw --force delete allow in on virbr0 to any port 53 proto tcp >/dev/null 2>&1 || true
sudo ufw --force delete allow in on virbr0 to any port 53 proto udp >/dev/null 2>&1 || true
sudo ufw --force delete allow in on virbr0 to any port 67 proto udp >/dev/null 2>&1 || true
sudo ufw --force delete route allow in on virbr0 >/dev/null 2>&1 || true
sudo ufw reload >/dev/null
if ! omarchy-pkg-drop dnsmasq virt-manager qemu-desktop; then
  echo "Package removal failed"
  exit 1
fi

echo ""
echo "QEMU and Virtual Machine Manager have been removed."
